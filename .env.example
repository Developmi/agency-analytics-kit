# =============================================================================
# Agency Analytics Kit - Environment Variables
# =============================================================================
# Master reference for all available variables. Each service (services/*/)
# reads its own .env - use this template to fill them.
#
# Quick start:
#   cp .env.example services/db/.env
#   cp .env.example services/pipeline/.env
#   cp .env.example services/metabase/.env
# Then edit each file, keeping only the relevant section.

# ─── DB (services/db/.env) ──────────────────────────────────────────────────
POSTGRES_DB=agency_dw
POSTGRES_USER=agency_admin
POSTGRES_PASSWORD=cambia_esto_en_produccion
# Password of the `metabase_reader` role, re-created by services/db/init/
# 02-bootstrap-rbac.sh on wipe. MUST match Metabase's MB_DB_PASS below so the
# role is re-created with the right password.
METABASE_READER_PASSWORD=cambia_esto_en_produccion

# ─── Pipeline - Postgres connection (services/pipeline/.env) ────────────────
# HOST and PORT are set by compose.yaml. Override here only for local dev.
# DESTINATION__POSTGRES__CREDENTIALS__HOST=localhost
# DESTINATION__POSTGRES__CREDENTIALS__PORT=5432
DESTINATION__POSTGRES__CREDENTIALS__DATABASE=agency_dw
DESTINATION__POSTGRES__CREDENTIALS__USERNAME=agency_admin
DESTINATION__POSTGRES__CREDENTIALS__PASSWORD=cambia_esto_en_produccion

# ─── Pipeline - Telegram alerts ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Pipeline - Connector tokens (per client) ───────────────────────────────
# Token per client. Name must match `token_env` in clients/<client>.yml.
# Suffix is the CLIENT_ID (uppercase), eg. _ACME, _NIKE
META_ACCESS_TOKEN_ACME=
META_ACCESS_TOKEN_NIKE=
TIKTOK_ACCESS_TOKEN_ACME=
TIKTOK_ACCESS_TOKEN_NIKE=
GOOGLE_ADS_TOKEN_ACME=
GOOGLE_ADS_DEVELOPER_TOKEN=
FACEBOOK_ACCESS_TOKEN_ACME=
INSTAGRAM_ACCESS_TOKEN_ACME=
TIKTOK_ORGANIC_ACCESS_TOKEN_ACME=
TIKTOK_ORGANIC_CLIENT_KEY_ACME=
TIKTOK_ORGANIC_CLIENT_SECRET_ACME=
TIKTOK_ORGANIC_REFRESH_TOKEN_ACME=
YOUTUBE_API_KEY_ACME=
PINTEREST_ACCESS_TOKEN_ACME=
GA4_ACCESS_TOKEN_ACME=
GTM_ACCESS_TOKEN_ACME=

# ─── Pipeline - YouTube OAuth (consent + connector) ─────────────────────────
# Generic keys (no client literal) read/written by
# scripts/youtube_oauth_consent.py: client id + secret are read from .env, the
# refresh token is written back after the consent flow. The YouTube connector
# resolves its own env names from oauth_client_id_env / oauth_client_secret_env
# / oauth_refresh_token_env in clients/<client>.yml, so point them at these
# keys (or at suffixed variants for per-client setups, e.g. YOUTUBE_OAUTH_*_NIKE
# + `python scripts/youtube_oauth_consent.py --env-suffix _NIKE`).
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# ─── Metabase (services/metabase/.env) ──────────────────────────────────────
MB_DB_DBNAME=agency_dw
MB_DB_HOST=agency_postgres
MB_DB_PORT=5432
MB_DB_USER=metabase_reader
MB_DB_PASS=cambia_esto_en_produccion
MB_DB_TYPE=postgres
