MB_DB_TYPE=changeme
MB_DB_DBNAME=changeme
MB_DB_HOST=changeme
MB_DB_PORT=5432
MB_DB_USER=changeme
# MUST match METABASE_READER_PASSWORD (services/db/.env): the init bootstrap
# re-creates the `metabase_reader` role with that password on wipe, and this is
# the password Metabase connects with.
MB_DB_PASS=changeme
