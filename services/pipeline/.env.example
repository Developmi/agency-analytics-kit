# dlt destination
DESTINATION__POSTGRES__CREDENTIALS__DATABASE=changeme
DESTINATION__POSTGRES__CREDENTIALS__USERNAME=changeme
DESTINATION__POSTGRES__CREDENTIALS__PASSWORD=changeme
DESTINATION__POSTGRES__CREDENTIALS__PORT=5432

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Connector tokens (per-client pattern)
META_ACCESS_TOKEN_CLIENT=changeme
FACEBOOK_ACCESS_TOKEN_CLIENT=changeme
INSTAGRAM_ACCESS_TOKEN_CLIENT=changeme

# YouTube OAuth (generic keys, no client literal). The connector reads its env
# names from oauth_client_id_env / oauth_client_secret_env /
# oauth_refresh_token_env in clients/<client>.yml — keep those in sync with the
# keys below, or use suffixed variants for per-client setups
# (e.g. YOUTUBE_OAUTH_CLIENT_ID_ACME). scripts/youtube_oauth_consent.py writes
# the refresh token back here.
YOUTUBE_OAUTH_CLIENT_ID=changeme
YOUTUBE_OAUTH_CLIENT_SECRET=changeme
YOUTUBE_OAUTH_REFRESH_TOKEN=changeme

POSTGRES_DB=agency_dw
POSTGRES_USER=agency_admin
POSTGRES_PASSWORD=changeme
