
POSTGRES_USER=changeme
POSTGRES_DB=changeme
POSTGRES_PASSWORD=changeme
# Password of the `metabase_reader` role, re-created idempotently by init/
# 02-bootstrap-rbac.sh on wipe (DO-block guard). MUST match Metabase's
# MB_DB_PASS (services/metabase/.env) so the role is re-created with the
# right password after `down -v`.
METABASE_READER_PASSWORD=changeme
# Opt-in gate for the Metabase read-only role (design D5, multi-tenancy-real).
# OFF default: 02-bootstrap-rbac.sh v2 creates NO `metabase_reader` role or
# grants. Exact "true" enables the idempotent branch; apply over an existing
# volume by flipping this and re-running the init script on the container.
METABASE_READER_ENABLED=false